# Lấy tại https://console.soniox.com → API Keys. CHỈ để ở server, không bao giờ đưa ra trình duyệt.
SONIOX_API_KEY=

# Mật khẩu vào app (chống người lạ dùng tốn tiền API).
APP_PASSWORD=

# Khoá Gemini để tóm tắt và dịch (chế độ tiết kiệm). Lấy tại https://aistudio.google.com/apikey — nhớ bật thanh toán (gói trả phí thì Google không dùng nội dung để huấn luyện).
GEMINI_API_KEY=

# (Tuỳ chọn) Khoá Groq để tóm tắt thay Gemini. Có khoá này thì tóm tắt dùng Groq. Lấy tại https://console.groq.com/keys
GROQ_API_KEY=
